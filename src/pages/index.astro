---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

// WhatsApp configuration (Pesan default untuk tombol di atas)
const whatsappNumber = "6282268946552"; 
const whatsappMessage = "Halo Kedai Pak Oteh, saya ingin pesan layanan/isi pulsa.";
const whatsappLink = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;

const variants = [
    {
        name: "Pulsa & Paket Data",
        description: "Melayani semua operator (Telkomsel, Indosat, XL, Tri, Smartfren). Proses cepat dan murah.",
        image: "/images/layanan_pulsa.png",
        tag: "Paling Laris",
        waMessage: "Halo Kedai Pak Oteh, saya ingin beli pulsa/paket data." // PESAN KHUSUS
    },
    {
        name: "Top Up E-Wallet",
        description: "Isi saldo DANA, OVO, GoPay, ShopeePay, LinkAja dengan mudah dan aman.",
        image: "/images/layanan_ewallet.png",
        tag: "Praktis",
        waMessage: "Halo Kedai Pak Oteh, saya ingin top up e-wallet (DANA/OVO/Gopay/dll)." // PESAN KHUSUS
    },
    {
        name: "Top Up Game",
        description: "Top up Diamond Mobile Legends, Free Fire, PUBG, dan game favorit lainnya.",
        image: "/images/layanan_game.png",
        tag: "Favorit",
        waMessage: "Halo Kedai Pak Oteh, saya ingin top up game (ML/FF/PUBG/dll)." // PESAN KHUSUS
    },
    {
        name: "Print & Fotocopy",
        description: "Cetak dokumen, fotocopy murah, jilid, print warna.",
        image: "/images/layanan_print.png",
        tag: "Lengkap",
        waMessage: "Halo Kedai Pak Oteh, saya ingin print/fotocopy dokumen." // PESAN KHUSUS
    },
    {
        name: "Transfer Bank",
        description: "Layanan setor tunai dan transfer antar bank dengan biaya admin terjangkau.",
        image: "/images/layanan_bank.png",
        tag: "Aman",
        waMessage: "Halo Kedai Pak Oteh, saya ingin transfer bank/setor tunai." // PESAN KHUSUS
    }
];

const testimonials = [
    {
        name: "Warga Teluk Pinang",
        comment: "Mantap, isi pulsa dan print tugas anak tinggal ke Kedai Pak Oteh. Gak perlu jauh-jauh ke kota.",
        city: "Teluk Pinang"
    },
    {
        name: "Pembeli Online",
        comment: "Top up game di sini prosesnya cepet banget, harganya juga bersahabat.",
        city: "Pelanggan Setia"
    }
];
---

<Layout title="Kedai Pak Oteh - Solusi Digital & Cetak">
	<main class="overflow-x-hidden">
		<!-- Navigation (Sticky) -->
		<nav class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-red-100 py-4">
			<div class="container mx-auto px-6 flex justify-between items-center">
				<div class="flex items-center gap-2">
					<div class="w-10 h-10 bg-red-600 rounded-full flex items-center justify-center text-white font-bold italic">K</div>
					<span class="text-xl font-extrabold text-red-600 tracking-tight">KEDAI<span class="text-green-600">PAK OTEH</span></span>
				</div>
				<a href={whatsappLink} class="hidden md:block bg-red-600 hover:bg-red-700 text-white px-5 py-2 rounded-full font-semibold transition-all">Pesan Sekarang</a>
			</div>
		</nav>

		<!-- Hero Section -->
		<section class="relative pt-20 pb-16 md:pt-32 md:pb-24">
			<div class="container mx-auto px-6 grid md:grid-cols-2 gap-12 items-center">
				<div class="space-y-8">
					<div class="inline-block bg-red-100 text-red-600 px-4 py-1.5 rounded-full text-sm font-bold tracking-wide uppercase">
						📱 Layanan Lengkap & Terpercaya
					</div>
					<h1 class="text-5xl md:text-7xl font-black leading-tight text-slate-900">
						Solusi <span class="text-red-600">Kebutuhan</span> <br/> <span class="text-green-600">Digital & Cetak</span> Anda!
					</h1>
					<p class="text-lg md:text-xl text-slate-600 leading-relaxed max-w-lg">
						Kedai Pak Oteh melayani isi pulsa, kuota, top up game, e-wallet, print, fotocopy, spanduk, hingga transfer bank. <br/><br/>
						<strong>📍 Lokasi: Jln. Merdeka Parit 6, Kelurahan Teluk Pinang.</strong>
					</p>
					<div class="flex flex-col sm:flex-row gap-4">
						<a href={whatsappLink} class="flex items-center justify-center gap-3 bg-green-600 hover:bg-green-700 text-white text-lg font-bold px-8 py-4 rounded-2xl shadow-xl shadow-green-200 hover:-translate-y-1 transition-all">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
							Chat Admin Sekarang
						</a>
						<a href="#layanan" class="flex items-center justify-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-lg font-bold px-8 py-4 rounded-2xl transition-all">
							Lihat Layanan
						</a>
					</div>
				</div>
				<div class="relative">
					<div class="absolute inset-0 bg-red-200 blur-3xl rounded-full opacity-30 animate-pulse"></div>
					<img src="/images/hero.png" alt="Kedai Pak Oteh" class="relative z-10 rounded-[2.5rem] shadow-2xl rotate-3 hover:rotate-0 transition-transform duration-500 object-cover aspect-[4/3]" loading="eager" />
				</div>
			</div>
		</section>

		<!-- Layanan Section -->
		<section id="layanan" class="py-24 bg-white">
			<div class="container mx-auto px-6">
				<div class="text-center mb-16 space-y-4">
					<h2 class="text-4xl md:text-5xl font-black text-slate-900">Layanan <span class="text-red-600">Kami</span></h2>
					<p class="text-slate-600 max-w-2xl mx-auto">Kami menyediakan berbagai kebutuhan digital dan cetak dengan harga bersahabat dan pelayanan cepat.</p>
				</div>
				
				<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
					{variants.map((variant) => {
						// INI DIA TRIKNYA: Kita bikin link WA khusus untuk masing-masing katalog
						const dynamicWaLink = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(variant.waMessage)}`;
						
						return (
							<div class="group bg-white border border-slate-100 rounded-3xl p-6 hover:shadow-2xl hover:border-red-100 transition-all duration-300">
								<div class="relative mb-6 overflow-hidden rounded-2xl aspect-square bg-slate-50 flex items-center justify-center">
									<img src={variant.image} alt={variant.name} class="w-full h-full object-cover group-hover:scale-110 transition-all duration-500" loading="lazy" />
									<span class="absolute top-4 left-4 bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-tighter shadow-lg">{variant.tag}</span>
								</div>
								<div class="space-y-3">
									<h3 class="text-xl font-bold text-slate-900">{variant.name}</h3>
									<p class="text-slate-600 text-sm leading-relaxed">{variant.description}</p>
									
									<div class="pt-4 border-t border-slate-50">
										{/* TOMBOL INI SEKARANG MENGGUNAKAN dynamicWaLink */}
										<a href={dynamicWaLink} class="w-full flex items-center justify-center gap-2 py-2.5 bg-red-50 text-red-600 rounded-xl group-hover:bg-red-600 group-hover:text-white transition-colors font-semibold text-sm">
											Pesan Layanan
											<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
										</a>
									</div>
								</div>
							</div>
						);
					})}
				</div>
			</div>
		</section>

		<!-- Testimonial Section -->
		<section id="testimoni" class="py-24 bg-[#FEF2F2]">
			<div class="container mx-auto px-6">
				<div class="text-center mb-16 space-y-4">
					<h2 class="text-4xl md:text-5xl font-black text-slate-900">Kata Pelanggan</h2>
					<p class="text-slate-600">Apa kata mereka yang sudah berbelanja di Kedai Pak Oteh?</p>
				</div>
				<div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
					{testimonials.map((testi) => (
						<div class="bg-white p-8 rounded-3xl shadow-lg border border-red-50 relative overflow-hidden">
							<div class="absolute top-0 right-0 p-4 opacity-10">
								<svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" fill="currentColor" class="bi bi-chat-quote" viewBox="0 0 16 16">
									<path d="M2.678 11.894a1 1 0 0 1 .287.801 10.97 10.97 0 0 1-.398 2c1.395-.323 2.247-.697 2.634-.893a1 1 0 0 1 .71-.074A8.06 8.06 0 0 0 8 14c3.996 0 7-2.807 7-6 0-3.192-3.004-6-7-6S1 4.808 1 8c0 1.468.617 2.83 1.678 3.894zm-.493 3.905a21.682 21.682 0 0 1-.713.129c-.2.032-.352-.176-.273-.362a9.68 9.68 0 0 0 .244-.637l.003-.01c.248-.72.45-1.548.524-2.319C.743 11.37 0 9.76 0 8c0-3.866 3.582-7 8-7s8 3.134 8 7-3.582 7-8 7a9.06 9.06 0 0 1-2.347-.306c-.52.263-1.639.742-3.468 1.105z"/>
									<path d="M7.066 6.76c-.088.33-.24.647-.514.904a.676.676 0 0 1-.15.12.774.774 0 0 1-.39.12c-.131 0-.258-.045-.346-.122-.138-.124-.194-.332-.194-.547 0-.235.067-.458.147-.65.08-.192.19-.34.306-.47.116-.13.25-.224.372-.284A.459.459 0 0 1 6.55 5.8c.12 0 .216.03.29.08.13.091.238.21.315.367.079.157.127.329.15.513zm1.867 0c-.088.33-.24.647-.514.904a.676.676 0 0 1-.15.12.774.774 0 0 1-.39.12c-.131 0-.258-.045-.346-.122-.138-.124-.194-.332-.194-.547 0-.235.067-.458.147-.65.08-.192.19-.34.306-.47.116-.13.25-.224.372-.284A.459.459 0 0 1 8.416 5.8c.12 0 .216.03.29.08.13.091.238.21.315.367.079.157.127.329.15.513z"/>
								</svg>
							</div>
							<div class="flex gap-1 text-yellow-500 mb-4">
								{[...Array(5)].map(() => (
									<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z"/></svg>
								))}
							</div>
							<p class="text-lg italic text-slate-700 leading-relaxed mb-6 font-medium">"{testi.comment}"</p>
							<div class="flex items-center gap-4">
								<div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center text-red-600 font-bold uppercase">{testi.name[0]}</div>
								<div>
									<h4 class="font-bold text-slate-900">{testi.name}</h4>
									<p class="text-xs text-slate-500">{testi.city}</p>
								</div>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- CTA Footer -->
		<section class="py-20 bg-slate-900">
			<div class="container mx-auto px-6 text-center space-y-8">
				<h2 class="text-4xl md:text-5xl font-black text-white leading-tight">Butuh Isi Pulsa atau <span class="text-red-500 italic">Print</span>?</h2>
				<p class="text-slate-400 max-w-xl mx-auto">Klik tombol di bawah untuk langsung terhubung dengan admin kami. Pelayanan cepat, harga bersahabat!</p>
				<a href={whatsappLink} class="inline-flex items-center gap-3 bg-red-600 hover:bg-red-700 text-white text-xl font-bold px-12 py-5 rounded-2xl shadow-2xl shadow-red-900/50 hover:-translate-y-1 transition-all">
					Pesan Lewat WhatsApp Sekarang
				</a>
				<p class="text-slate-500 text-sm mt-8">© 2026 Kedai Pak Oteh. Jln. Merdeka Parit 6, Teluk Pinang.</p>
			</div>
		</section>
	</main>
</Layout>
